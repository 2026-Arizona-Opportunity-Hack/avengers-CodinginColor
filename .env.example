# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# Backend only: restricted runtime login; never use the migration owner here.
DATABASE_URL=postgresql://cic_app:REPLACE_ME@localhost:5432/cic
# Single CIC deployment organization; must match a provisioned organization UUID.
CIC_ORG_ID=00000000-0000-4000-8000-000000000001
# Privileged migration connection; do not configure on the application runtime.
MIGRATION_DATABASE_URL=postgresql://cic_migrator:REPLACE_ME@localhost:5432/cic
CLERK_SECRET_KEY=REPLACE_ME
CLERK_JWT_ISSUER=https://REPLACE_ME.clerk.accounts.dev
APP_ORIGIN=http://localhost:4200
PORT=3000

# Public frontend configuration. These are not secret credentials.
CLERK_PUBLISHABLE_KEY=REPLACE_ME
API_BASE_URL=http://localhost:3000/api/v1

# AI is optional and is not required by the core backend.
# OPENAI_BASE_URL=https://ai.ohack.dev/v1
# OPENAI_API_KEY=REPLACE_ME
# TypeSafe Jev column suggestions are optional. Never put a real key here.
# TYPESAFE_API_KEY=REPLACE_ME
