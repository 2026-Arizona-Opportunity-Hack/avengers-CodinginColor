{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci && npm ci --prefix apps/web",
  "buildCommand": "node deploy/check-env.ts && npm run build --prefix apps/web && node deploy/vercel-build.ts",
  "functions": {
    "src/index.ts": { "includeFiles": "public/**" }
  },
  "rewrites": [
    { "source": "/((?!api/|healthz).*)", "destination": "/index.html" }
  ]
}
