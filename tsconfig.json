{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": ["packages/contracts/**/*.ts", "apps/api/**/*.ts", "db/**/*.ts", "src/**/*.ts", "deploy/**/*.ts", "tests/migrate.test.ts", "tests/deployment-env.test.ts"]
}
